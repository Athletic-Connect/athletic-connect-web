---
// "Show more" reveal under the 6 headline features. Two honest groups:
// add-on modules (may cost extra) and platform (included with every plan).
// Progressive enhancement: content renders visible; JS collapses it and wires
// the toggle, so no-JS visitors still see everything.
import FeatureCard from './FeatureCard.astro';
import { moreModules, morePlatform } from '../data/modules';
---

<section class="pad more">
  <div class="wrap">
    <div class="toggle">
      <button
        class="btn ghost"
        data-more-toggle
        aria-controls="more-panel"
        hidden
      >
        <span data-label>Show more</span>
      </button>
    </div>

    <div id="more-panel">
      <div class="head center">
        <div class="eyebrow">More of what's inside</div>
      </div>

      <div class="group">
        <div class="glabel">
          <h3>Additional modules</h3>
        </div>
        <div class="grid">
          {moreModules.map((c) => <FeatureCard feature={c} />)}
        </div>
      </div>

      <div class="group">
        <div class="glabel">
          <h3>Platform</h3>
        </div>
        <div class="grid">
          {morePlatform.map((c) => <FeatureCard feature={c} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
  const panel = document.getElementById('more-panel');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  if (btn && panel) {
    btn.hidden = false;
    panel.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', () => {
      const willOpen = panel.hidden;
      panel.hidden = !willOpen;
      btn.setAttribute('aria-expanded', String(willOpen));
      if (label) label.textContent = willOpen ? 'Show less' : 'Show more';
    });
  }
</script>

<style>
  .more {
    padding-top: 0;
  }
  .toggle {
    text-align: center;
    margin-bottom: 8px;
  }
  #more-panel {
    margin-top: 28px;
  }
  .head {
    margin-bottom: 26px;
  }
  .group + .group {
    margin-top: 40px;
  }
  .glabel {
    margin-bottom: 18px;
  }
  .glabel h3 {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .glabel p {
    font-size: 13.5px;
    color: var(--muted);
    margin-top: 4px;
  }
  .glabel a {
    color: var(--orange);
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
