---
// Landing hero with the "product console" mock on the right.
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Built for clubs · basketball-first</div>
      <h1>Less admin.<br /><span class="o">More game.</span></h1>
      <p class="lead">
        Athletic Connect brings registration, scheduling, tournaments,
        evaluations, payments, and your team store into one place — so you spend
        less time buried in busywork and more time with the players, families,
        and sport you got into this for.
      </p>
      <div class="cbtns">
        <a href="/#demo" class="btn">Request a demo</a>
        <a href="/features/" class="btn ghost">See how it works</a>
      </div>
      <div class="tiny">
        No big upfront cost · set up in a weekend · your data stays yours.
      </div>
    </div>

    <div class="mock" aria-hidden="true">
      <div class="bar"><i></i><i></i><i></i></div>
      <div class="body">
        <div class="h">
          <b>Bay City Basketball — Fall 2026</b>
          <span class="pill">Registration open</span>
        </div>
        <div class="tiles">
          <div class="tile"><div class="n">184</div><div class="l">Players</div></div>
          <div class="tile"><div class="n o">$142k</div><div class="l">Collected</div></div>
          <div class="tile"><div class="n">6</div><div class="l">This week</div></div>
        </div>
        <div class="rows">
          <div class="r"><span class="who">14U Boys · Elite</span><span class="st">Roster full</span></div>
          <div class="r"><span class="who">12U Girls · Red</span><span class="st due">3 spots left</span></div>
          <div class="r"><span class="who">Fall Kickoff Tournament</span><span class="st">Bracket set</span></div>
          <div class="r"><span class="who">Uniform pickup — Sat</span><span class="st">Ready</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        1100px 520px at 78% -10%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding: 64px 0 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .hero-grid > * {
    min-width: 0;
  }
  h1 {
    margin-top: 12px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 20px 0 28px;
    max-width: 560px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .tiny {
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
  }

  /* product mock */
  .mock {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-mock);
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    background: #f5f5f6;
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d6d6d9;
    display: inline-block;
  }
  .body {
    padding: 18px;
  }
  .h {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .h b {
    font-size: 15px;
  }
  .pill {
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: var(--orange);
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }
  .tile {
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 11px;
  }
  .tile .n {
    font-size: 20px;
    font-weight: 800;
  }
  .tile .n.o {
    color: var(--orange);
  }
  .tile .l {
    font-size: 10.5px;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rows .r {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 2px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .rows .r:last-child {
    border-bottom: 0;
  }
  .rows .r .who {
    font-weight: 600;
  }
  .rows .r .st {
    font-size: 11px;
    font-weight: 700;
    color: var(--ok-text);
    background: var(--ok-bg);
    padding: 3px 9px;
    border-radius: 14px;
  }
  .rows .r .st.due {
    color: var(--orange);
    background: var(--orange-soft);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }
  }
</style>
