---
// Landing hero. Copy on top, then a full-width screenshot of the real director
// dashboard, captured from the product with sample data for "Example Club".
---

<section class="hero">
  <div class="wrap copy">
    <div class="eyebrow">Built for clubs · basketball-first</div>
    <h1>Less admin. <span class="o">More game.</span></h1>
    <p class="lead">
      Athletic Connect brings program registration, scheduling, tournaments,
      evaluations, payments, and coaching tools into one place, so you spend
      less time buried in busywork and more time with the players, families,
      and sport you got into this for.
    </p>
    <div class="cbtns">
      <a href="/#demo" class="btn">Request a demo</a>
      <a href="/features/" class="btn ghost">See how it works</a>
    </div>
  </div>

  <div class="wrap">
    <figure class="shot">
      <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img
        src="/product/dashboard.png"
        alt="The Athletic Connect director dashboard: a work queue of support tickets, evaluations and tournaments, alongside financial, registration and program summaries."
        width="1760"
        height="737"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(
        1100px 560px at 50% -10%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding: 66px 0 78px;
    overflow: hidden;
  }
  .copy {
    text-align: center;
    max-width: 800px;
  }
  h1 {
    margin-top: 12px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 20px auto 28px;
    max-width: 620px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Product screenshot in a browser frame ---------------------------------- */
  .shot {
    margin: 46px auto 0;
    background: #fff;
    border: 1px solid var(--line);
    border-top-left-radius: var(--r-lg);
    border-top-right-radius: var(--r-lg);
    border-bottom: 0;
    box-shadow: var(--shadow-mock);
    overflow: hidden;
    min-width: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    background: #f5f5f6;
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d6d6d9;
    display: inline-block;
  }

  @media (max-width: 820px) {
    .hero {
      padding-top: 52px;
      padding-bottom: 54px;
    }
    .shot {
      margin-top: 34px;
    }
  }
</style>
