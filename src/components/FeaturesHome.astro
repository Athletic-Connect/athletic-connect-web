---
// Home features grid: the mockup's six benefit cards, with the Team Store card
// replaced by the Coach's Toolbox card (per Nick's early feedback).
import FeatureCard from './FeatureCard.astro';
import { homeFeatures } from '../data/features';
---

<section class="pad" id="features">
  <div class="wrap">
    <div class="center">
      <div class="eyebrow">Everything a program needs</div>
      <h2>Run the whole season from one screen.</h2>
      <p class="sec-sub">
        The work that keeps directors up at night. Organized, connected, and
        finally under control.
      </p>
    </div>
    <div class="fgrid">
      {homeFeatures.map((f) => <FeatureCard feature={f} />)}
    </div>
    <div class="more">
      <a href="/features/" class="btn ghost">Explore every feature</a>
    </div>
  </div>
</section>

<style>
  .fgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .more {
    text-align: center;
    margin-top: 36px;
  }

  @media (max-width: 820px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
