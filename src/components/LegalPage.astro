---
// Shared shell for the legal pages (Terms, Privacy). Content comes in via slot.
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  intro: string;
  updated: string;
}
const { title, description, path, heading, intro, updated } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <section class="lhead pad">
    <div class="wrap center">
      <div class="eyebrow">Legal</div>
      <h1>{heading}</h1>
      <p class="lead">{intro}</p>
      <p class="updated">Last updated {updated}</p>
    </div>
  </section>

  <section class="lbody pad">
    <div class="wrap legal">
      <slot />
    </div>
  </section>
</Base>

<style is:global>
  .lhead {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .lhead .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 0;
    max-width: 620px;
  }
  .lhead .updated {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted);
  }
  .lbody {
    padding-top: 40px;
  }
  .legal {
    max-width: 720px;
  }
  .legal h2 {
    font-size: clamp(20px, 2.4vw, 24px);
    margin: 40px 0 12px;
  }
  .legal h2:first-child {
    margin-top: 0;
  }
  .legal h3 {
    font-size: 17px;
    margin: 26px 0 8px;
  }
  .legal p {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .legal ul {
    margin: 0 0 18px;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 9px;
  }
  .legal li {
    position: relative;
    padding-left: 22px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.6;
  }
  .legal li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .legal a {
    color: var(--orange);
    font-weight: 600;
  }
</style>
