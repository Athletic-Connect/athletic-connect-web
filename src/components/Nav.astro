---
import { navLinks } from '../data/site';
---

<header>
  <div class="wrap">
    <nav aria-label="Primary">
      <a href="/" class="brand" aria-label="Athletic Connect — home">
        <img
          src="/brand/logo-wide.png"
          alt="Athletic Connect"
          class="logo"
          width="330"
          height="60"
        />
      </a>
      <div class="links">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="navcta">
        <a href="/#demo" class="signin">Sign in</a>
        <a href="/#demo" class="btn">Request a demo</a>
      </div>
      <button
        class="burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mnav"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
  <div id="mnav" hidden>
    {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/#demo">Request a demo</a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .logo {
    height: 30px;
    width: auto;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .links a {
    font-size: 14.5px;
    font-weight: 600;
    color: #33363b;
  }
  .links a:hover {
    color: var(--orange);
  }
  .navcta {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .navcta .signin {
    font-size: 14.5px;
    font-weight: 600;
    color: #33363b;
  }
  .navcta .signin:hover {
    color: var(--orange);
  }
  .navcta .btn {
    padding: 10px 18px;
    font-size: 14px;
  }
  .burger {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .burger span {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--ink);
    margin: 4px 0;
    border-radius: 2px;
  }
  #mnav {
    border-top: 1px solid var(--line);
    background: #fff;
  }
  #mnav a {
    display: block;
    padding: 14px 22px;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
    .navcta .btn,
    .navcta .signin {
      display: none;
    }
    .burger {
      display: block;
    }
  }
</style>
