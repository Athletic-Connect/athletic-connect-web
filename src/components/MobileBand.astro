---
/**
 * Two-column band pairing copy with a real phone screenshot of the member
 * (family) side of the product.
 *
 * Screenshots are captured from the live app and scrubbed: the club is renamed
 * to "Example Club" and the family's street address is removed. Nothing here
 * claims a native app, since there is not one yet.
 */
interface Frame {
  src: string;
  alt: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  /** A single still. */
  image?: string;
  alt?: string;
  /** Or several screens that cycle in the phone. First one shows first. */
  frames?: Frame[];
  /** Put the phone on the left instead of the right. */
  flip?: boolean;
}
const { eyebrow, heading, body, image, alt, frames, flip = false } = Astro.props;
---

<section class="mband pad">
  <div class:list={['wrap in', { flip }]}>
    <div class="copy">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="shot">
      {
        frames ? (
          <div class="cycler" data-cycler>
            <div class="frames" data-frames>
              {frames.map((f, i) => (
                <img
                  src={f.src}
                  alt={f.alt}
                  width="458"
                  height="780"
                  class:list={[{ on: i === 0 }]}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  draggable={false}
                />
              ))}
            </div>
            <div class="dots">
              {frames.map((_, i) => (
                <button
                  type="button"
                  class:list={[{ on: i === 0 }]}
                  aria-label={`Show screen ${i + 1} of ${frames.length}`}
                  data-dot={i}
                />
              ))}
            </div>
          </div>
        ) : (
          <img src={image} alt={alt} width="458" height="780" loading="lazy" />
        )
      }
    </div>
  </div>
</section>

<style>
  .mband {
    background: var(--wash);
  }
  .in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: 56px;
    align-items: center;
  }
  .in.flip .copy {
    order: 2;
  }
  .in.flip .shot {
    order: 1;
  }
  .in > * {
    min-width: 0;
  }
  h2 {
    margin-top: 10px;
  }
  .copy p {
    color: var(--ink-2);
    font-size: 17px;
    margin-top: 14px;
    max-width: 460px;
  }
  .shot {
    display: flex;
    justify-content: center;
  }
  .shot img {
    width: 100%;
    max-width: 300px;
    height: auto;
    border-radius: 26px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-mock);
  }

  /* Cycling phone. State is driven by script so the screens can also be
     swiped; the first frame carries .on from the server, so with no JS the
     phone still shows a screen. */
  .cycler {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .frames {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 458 / 780;
    /* let vertical scrolling through, capture horizontal for swipes */
    touch-action: pan-y;
    cursor: grab;
  }
  .frames.dragging {
    cursor: grabbing;
  }
  .frames img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    transition: opacity 0.5s ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .frames img.on {
    opacity: 1;
  }

  .dots {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #d5d7dd;
    cursor: pointer;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }
  .dots button.on {
    background: var(--orange);
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .frames img {
      transition: none;
    }
  }

  @media (max-width: 820px) {
    .in {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }
    .in.flip .copy,
    .in.flip .shot {
      order: initial;
    }
  }
</style>

<script>
  // Phone screen cycler: auto-advances, and can be swiped or dotted through.
  // Everything here is progressive enhancement, the first frame is already
  // visible from the server.
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HOLD = 7000;
  const SWIPE = 40;

  for (const root of document.querySelectorAll<HTMLElement>('[data-cycler]')) {
    const strip = root.querySelector<HTMLElement>('[data-frames]');
    const shots = [...root.querySelectorAll<HTMLImageElement>('[data-frames] img')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!strip || shots.length < 2) continue;

    let at = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      at = (next + shots.length) % shots.length;
      shots.forEach((el, i) => el.classList.toggle('on', i === at));
      dots.forEach((el, i) => el.classList.toggle('on', i === at));
    };

    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const play = () => {
      stop();
      // motion turned down: no unattended movement, but swiping still works
      if (!REDUCED) timer = window.setInterval(() => show(at + 1), HOLD);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => { show(i); play(); })
    );

    let startX: number | null = null;
    let startY = 0;

    const endDrag = () => {
      startX = null;
      strip.classList.remove('dragging');
      play();
    };

    strip.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
      strip.classList.add('dragging');
      strip.setPointerCapture(e.pointerId);
      stop();
    });

    strip.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      // only count it when the gesture is actually sideways, otherwise a
      // slightly diagonal page scroll drags the carousel with it
      if (Math.abs(dx) >= SWIPE && Math.abs(dx) > Math.abs(dy)) {
        show(at + (dx < 0 ? 1 : -1));
      }
      endDrag();
    });

    // the browser fires this when it takes the gesture over to scroll the
    // page, so it must never be treated as a swipe
    strip.addEventListener('pointercancel', endDrag);

    // do not keep animating a phone nobody is looking at
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? play() : stop()),
        { threshold: 0.2 }
      ).observe(root);
    } else {
      play();
    }
  }
</script>
