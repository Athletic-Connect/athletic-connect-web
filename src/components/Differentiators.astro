---
/**
 * The depth section: the two capabilities competitors are not offering.
 *
 * Deliberately not framed as "features" (the grid above already does breadth).
 * These are retention arguments: evaluations are why families stay, the
 * toolbox is why a program survives a coach leaving.
 */
const blocks = [
  {
    label: 'Evaluations',
    title: 'A development record that follows the player.',
    body: "Clear, actionable feedback for your club and its families. Customizable evaluations highlight strengths, identify what to work on, and build a record that follows the player. Because every season is scored the same way, you can see real growth instead of guessing at it.",
    image: '/product/evaluations.png',
    width: 2240,
    height: 820,
    alt: "An Athletic Connect player evaluation awaiting admin approval, showing skills assessed, ratings from developing to strength, and the coach's written comments.",
  },
  {
    label: "Coach's Toolbox",
    title: "Your program's standards, in every coach's hands.",
    body: "Guidelines, drills and sets live with the club, not on one coach's notepad. Coaches build a practice plan straight from your drill bank and drop it onto the calendar, so a new coach gets up to speed faster and every practice runs to the same standard.",
    pair: [
      {
        caption: 'Your drill bank',
        image: '/product/toolbox-drills.png',
        width: 1500,
        height: 603,
        alt: "The Athletic Connect drill bank, listing club drills with type, tags and court diagrams.",
      },
      {
        caption: "Tuesday's practice plan",
        image: '/product/toolbox-plan.png',
        width: 1500,
        height: 601,
        alt: 'A practice plan built from those drills, timed block by block from warm up through the shell drill.',
      },
    ],
  },
];
---

<section class="depth pad" id="depth">
  <div class="wrap">
    <div class="center">
      <div class="eyebrow">What the others don't do</div>
      <h2>Development you can measure. Coaching you can count on.</h2>
    </div>

    <div class="blocks">
      {
        blocks.map((b) => (
          <article class="block">
            <div class="copy">
              <div class="label">{b.label}</div>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </div>
            {
              b.pair ? (
                <div class="pair">
                  {b.pair.map((shot, i) => (
                    <>
                      {i === 1 && <div class="arrow" aria-hidden="true">→</div>}
                      <figure>
                        <figcaption>{shot.caption}</figcaption>
                        <img
                          src={shot.image}
                          alt={shot.alt}
                          width={shot.width}
                          height={shot.height}
                          loading="lazy"
                        />
                      </figure>
                    </>
                  ))}
                </div>
              ) : (
                <img
                  src={b.image}
                  alt={b.alt}
                  width={b.width}
                  height={b.height}
                  loading="lazy"
                />
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .depth {
    background: var(--paper);
  }
  .blocks {
    display: grid;
    gap: 64px;
    margin-top: 52px;
  }
  .copy {
    max-width: 620px;
  }
  .label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 8px;
  }
  .block h3 {
    font-size: clamp(21px, 2.6vw, 27px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 800;
  }
  .block p {
    color: var(--ink-2);
    font-size: 16.5px;
    margin-top: 12px;
  }
  /* Always stacked: the flow reads top to bottom, the arrow always points the
     way the eye travels, and each screenshot gets the full column width. */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 14px;
    margin-top: 24px;
  }
  .pair figure {
    width: 100%;
  }
  .pair figure {
    margin: 0;
    min-width: 0;
  }
  .pair figcaption {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .pair img {
    margin-top: 0;
  }
  .arrow {
    font-size: 26px;
    font-weight: 800;
    color: var(--orange);
    line-height: 1;
    transform: rotate(90deg);
    padding: 6px 0;
  }

  .block img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-mock);
  }
</style>
