---
// Renders a module / feature / capability card. Accepts anything with a
// title, an icon (inner SVG markup), a blurb, and optionally a longer detail
// and a small tag.
interface CardItem {
  title: string;
  blurb: string;
  detail?: string;
  icon: string;
  tag?: string;
}

interface Props {
  feature: CardItem;
  /** Use the longer copy (detail) instead of the grid blurb. */
  detailed?: boolean;
}
const { feature, detailed = false } = Astro.props;
const body = detailed && feature.detail ? feature.detail : feature.blurb;
---

<article class="fcard">
  <div class="ficon">
    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={feature.icon} />
  </div>
  <div class="titlerow">
    <h3>{feature.title}</h3>
    {feature.tag && <span class="tag">{feature.tag}</span>}
  </div>
  <p>{body}</p>
</article>

<style>
  .fcard {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 22px;
    background: #fff;
    height: 100%;
    transition:
      transform 0.12s,
      box-shadow 0.12s;
  }
  .fcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .ficon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: var(--orange-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .ficon svg {
    width: 23px;
    height: 23px;
    stroke: var(--orange);
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .titlerow {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 7px;
  }
  h3 {
    font-size: 17px;
  }
  .tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--orange);
    background: var(--orange-soft);
    padding: 3px 9px;
    border-radius: 20px;
  }
  p {
    font-size: 14px;
    color: var(--ink-3);
  }
</style>
