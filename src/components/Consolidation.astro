---
// "Stop duct-taping your program together": the all-in-one strip.
const replaced = [
  'Registration app',
  'Tournament software',
  'Team schedule app',
  'Evaluation tool',
  'Spreadsheet',
  'Group texts & email',
  'Payment plans by hand',
  'Chasing dues',
];
---

<section class="consol pad" id="platform">
  <div class="wrap in">
    <div>
      <div class="eyebrow soft">One platform, not six tabs</div>
      <h2>Stop duct-taping your program together.</h2>
      <p>
        Registration in one app, tournaments in another, a spreadsheet for
        schedules, group texts for everything else. Athletic Connect replaces
        the stack, with one login, one source of truth, and no more copying data
        between tools that don't talk to each other.
      </p>
      <div class="arrowline">
        <span>Six tools + a spreadsheet</span>
        <span class="o">→</span>
        <span>One platform.</span>
      </div>
    </div>
    <div class="chips">
      {replaced.map((tool) => <div class="chip"><s>{tool}</s></div>)}
    </div>
  </div>
</section>

<style>
  .consol {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #fff;
  }
  .in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .in > * {
    min-width: 0;
  }
  .consol h2 {
    color: #fff;
    margin-top: 10px;
  }
  .consol p {
    color: var(--navy-text);
    margin-top: 12px;
    font-size: 16px;
  }
  .eyebrow.soft {
    color: var(--orange-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    border: 1px solid var(--navy-line);
    border-radius: var(--r-sm);
    padding: 12px 14px;
    font-size: 13.5px;
    color: #eef1f6;
    background: var(--navy-surface);
  }
  .chip s {
    color: var(--navy-muted);
    position: relative;
    text-decoration: none;
  }
  /* our own strike line, so it can draw itself as the chip is revealed */
  .chip s::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 52%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.42s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .chip.rv-in s::after {
    transform: scaleX(1);
  }
  /* no reveal script, or motion turned down: fall back to a plain strike */
  .chip:not(.rv) s {
    text-decoration: line-through;
  }
  .chip:not(.rv) s::after {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .chip s {
      text-decoration: line-through;
    }
    .chip s::after {
      display: none;
    }
  }
  .arrowline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    font-weight: 800;
    font-size: 15px;
  }
  .arrowline .o {
    color: var(--orange);
  }

  @media (max-width: 820px) {
    .in {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
  }
</style>
