---
import Base from '../layouts/Base.astro';
import DemoCTA from '../components/DemoCTA.astro';
import { bundles, pricingPoints, enterprise } from '../data/pricing';
---

<Base
  title="Pricing"
  description="Simple pricing that grows with your program. No monthly subscription. Pick a plan and pay a small fee on the payments you process, dropping as you grow."
  path="/pricing/"
>
  <section class="phead pad">
    <div class="wrap center">
      <div class="eyebrow">Simple, and it scales with you</div>
      <h1>Pricing that grows as you do.</h1>
      <p class="lead">
        No monthly subscription. Pick a plan, pay a small fee on the payments
        you process, and it drops as your program grows.
      </p>
    </div>
  </section>

  <section class="pad plans-sec">
    <div class="wrap">
      <div class="plans">
        {
          bundles.map((plan) => (
            <article class:list={['plan', { featured: plan.featured }]}>
              {plan.featured && <div class="tag">Most popular</div>}
              <h2>{plan.name}</h2>
              <p class="who">{plan.who}</p>
              <div class="price">{plan.price}</div>
              <p class="note">{plan.priceNote}</p>
              <ul>
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                href={plan.ctaHref}
                class:list={['btn', { ghost: !plan.featured }]}
              >
                {plan.cta}
              </a>
            </article>
          ))
        }
      </div>

      <p class="alacarte">
        Prefer to pick and choose? You can buy just the modules you need, and
        the more you bundle, the less the combined price. <a href="/#demo">Ask us for a quote.</a>
      </p>

      <div class="fee">
        <h3>How you pay</h3>
        <ul>
          {pricingPoints.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div class="enterprise">
        <div>
          <div class="eyebrow">Enterprise</div>
          <h3>Running a district or a multi-sport organization?</h3>
          <p>{enterprise.who} We have a tier built for you, with the controls and support larger organizations need.</p>
        </div>
        <a href="/#demo" class="btn ghost">Contact us</a>
      </div>
    </div>
  </section>

  <DemoCTA
    heading="Not sure which fits?"
    sub="Tell us about your program and we'll put together pricing that matches your size and what you need."
  />
</Base>

<style>
  .phead {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding-top: 56px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 0;
    max-width: 560px;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 28px 24px;
    background: #fff;
  }
  .plan.featured {
    border-color: var(--orange);
    box-shadow: 0 18px 40px rgba(252, 66, 4, 0.12);
  }
  .tag {
    position: absolute;
    top: -12px;
    left: 24px;
    background: var(--orange);
    color: #fff;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 20px;
  }
  .plan h2 {
    font-size: 22px;
  }
  .who {
    color: var(--ink-3);
    font-size: 14px;
    margin-top: 8px;
    min-height: 40px;
  }
  .price {
    font-size: 26px;
    font-weight: 800;
    margin-top: 14px;
    color: var(--orange);
  }
  .note {
    color: var(--muted);
    font-size: 13px;
    margin-top: 6px;
    min-height: 36px;
  }
  .plan ul {
    list-style: none;
    margin: 18px 0 24px;
    display: grid;
    gap: 9px;
  }
  .plan li {
    position: relative;
    padding-left: 26px;
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--orange);
    font-weight: 800;
  }
  .plan .btn {
    margin-top: auto;
    text-align: center;
  }

  .alacarte {
    text-align: center;
    max-width: 560px;
    margin: 28px auto 0;
    font-size: 14.5px;
    color: var(--ink-3);
  }
  .alacarte a {
    color: var(--orange);
    font-weight: 600;
  }

  .fee {
    max-width: 620px;
    margin: 44px auto 0;
    text-align: center;
  }
  .fee h3 {
    font-size: 16px;
    margin-bottom: 14px;
  }
  .fee ul {
    list-style: none;
    display: inline-grid;
    gap: 8px;
    text-align: left;
  }
  .fee li {
    position: relative;
    padding-left: 24px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .fee li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--orange);
    font-weight: 800;
  }

  .enterprise {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 48px auto 0;
    padding: 26px 30px;
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .enterprise h3 {
    font-size: 20px;
    margin: 6px 0 8px;
  }
  .enterprise p {
    color: var(--ink-3);
    font-size: 14.5px;
    max-width: 560px;
  }
  .enterprise .btn {
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
      max-width: 460px;
      margin: 0 auto;
    }
  }
</style>
