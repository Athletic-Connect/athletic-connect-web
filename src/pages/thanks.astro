---
// Confirmation page for the Netlify demo form. Keeps the visitor on our own
// site instead of Netlify's generic default success screen.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Thanks"
  description="Thanks for reaching out to Athletic Connect. We'll be in touch to set up your walkthrough."
  path="/thanks/"
  noindex
>
  <section class="thanks pad">
    <div class="wrap center">
      <div class="tick" aria-hidden="true">✓</div>
      <div class="eyebrow">Request received</div>
      <h1>Thanks. We'll be in touch.</h1>
      <p class="lead">
        We'll reach out shortly to set up a walkthrough on your own program's
        setup. Most requests hear back within one business day.
      </p>
      <div class="cbtns">
        <a href="/features/" class="btn">Explore the features</a>
        <a href="/pricing/" class="btn ghost">See pricing</a>
      </div>
      <div class="alt">
        Need us sooner? Email <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding: 84px 0 96px;
  }
  .tick {
    width: 58px;
    height: 58px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: var(--orange-soft);
    color: var(--orange);
    font-size: 28px;
    font-weight: 800;
    line-height: 58px;
  }
  h1 {
    margin-top: 12px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 0;
    max-width: 520px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 28px;
  }
  .alt {
    margin-top: 20px;
    font-size: 14px;
    color: var(--muted);
  }
  .alt a {
    color: var(--orange);
    font-weight: 600;
  }
</style>
