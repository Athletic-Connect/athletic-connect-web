---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Consolidation from '../components/Consolidation.astro';
import FeaturesHome from '../components/FeaturesHome.astro';
import Differentiators from '../components/Differentiators.astro';
import MobileBand from '../components/MobileBand.astro';
import ValueBand from '../components/ValueBand.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import DemoCTA from '../components/DemoCTA.astro';
---

<Base path="/">
  <Hero />
  <Consolidation />
  <FeaturesHome />
  <Differentiators />
  <MobileBand
    eyebrow="One home for families"
    heading="Your whole program. Just one tap away."
    body="Give families one simple, easy-to-navigate app for everything they need. Register for a clinic, check practice and weekend schedules, read current and past evaluations, or grab a new shirt from the team store, all at the tap of a button."
    frames={[
      {
        src: '/product/fam-1-schedule.png',
        alt: "A family's schedule on a phone, listing upcoming practices and games with times, teams and locations.",
      },
      {
        src: '/product/fam-2-classes.png',
        alt: 'Booked classes on a phone, each with its time, venue and free-cancellation window.',
      },
      {
        src: '/product/fam-3-family.png',
        alt: 'The family account on a phone, showing every child on one login.',
      },
    ]}
  />
  <ValueBand />
  <PricingTeaser />
  <DemoCTA />
</Base>
