---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import DemoCTA from '../components/DemoCTA.astro';
import { features } from '../data/features';
---

<Base
  title="Features"
  description="Everything a program needs — registration and payments, scheduling, tournaments, player evaluations, a coach's toolbox, one home for families, and a built-in team store."
  path="/features/"
>
  <section class="hero pad">
    <div class="wrap center">
      <div class="eyebrow">Everything a program needs</div>
      <h1>One platform. The whole season.</h1>
      <p class="lead">
        Athletic Connect replaces the stack of apps and spreadsheets clubs
        cobble together — registration, scheduling, tournaments, evaluations,
        the tools coaches use every day, and a team store, all connected in one
        place.
      </p>
      <div class="cbtns">
        <a href="/#demo" class="btn">Request a demo</a>
        <a href="/pricing/" class="btn ghost">See pricing</a>
      </div>
    </div>
  </section>

  <section class="pad grid-sec">
    <div class="wrap">
      <div class="fgrid">
        {features.map((f) => <FeatureCard feature={f} detailed />)}
      </div>
    </div>
  </section>

  <DemoCTA
    heading="Want to see it on your program?"
    sub="We'll walk you through it on your own club's setup. Leave your email and we'll reach out."
  />
</Base>

<style>
  .hero {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding-top: 56px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 26px;
    max-width: 620px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .grid-sec {
    padding-top: 8px;
  }
  .fgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 820px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
