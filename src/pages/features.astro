---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import RoleViews from '../components/RoleViews.astro';
import DemoCTA from '../components/DemoCTA.astro';
import { modules, platform } from '../data/modules';
---

<Base
  title="Features"
  description="The modules a program picks (Programs, Leagues, Tournaments, Evaluations, Team store, Film) plus the platform every plan includes: role-based views, reporting, import and export, and communication."
  path="/features/"
>
  <section class="hero pad">
    <div class="wrap center">
      <div class="eyebrow">Everything a program needs</div>
      <h1>One platform. The whole season.</h1>
      <p class="lead">
        Athletic Connect replaces the stack of apps and spreadsheets clubs
        cobble together. Choose the modules you need, and get the same solid
        platform underneath every one of them.
      </p>
      <div class="cbtns">
        <a href="/#demo" class="btn">Request a demo</a>
        <a href="/pricing/" class="btn ghost">See pricing</a>
      </div>
    </div>
  </section>

  <section class="pad" id="modules">
    <div class="wrap">
      <div class="head">
        <div class="eyebrow">Modules</div>
        <h2>Pick what you need. Add more as you grow.</h2>
        <p class="sec-sub">
          Each module is something you turn on when your program is ready for
          it. Start with Programs and expand from there.
        </p>
      </div>
      <div class="fgrid">
        {modules.map((m) => <FeatureCard feature={m} detailed />)}
      </div>
    </div>
  </section>

  <RoleViews />

  <section class="pad" id="platform">
    <div class="wrap">
      <div class="head">
        <div class="eyebrow">The platform</div>
        <h2>Included with every plan.</h2>
        <p class="sec-sub">
          Whichever modules you pick, these come with them. They are part of the
          platform, not add-ons you have to buy.
        </p>
      </div>
      <div class="pgrid">
        {platform.map((c) => <FeatureCard feature={c} />)}
      </div>
    </div>
  </section>

  <DemoCTA
    heading="Want to see it on your program?"
    sub="We will walk you through it on your own club's setup. Leave your email and we will reach out."
  />
</Base>

<style>
  .hero {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding-top: 56px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 26px;
    max-width: 620px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .fgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 900px) {
    .pgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .fgrid,
    .pgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
