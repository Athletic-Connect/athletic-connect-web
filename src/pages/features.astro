---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MoreFeatures from '../components/MoreFeatures.astro';
import RoleViews from '../components/RoleViews.astro';
import MobileBand from '../components/MobileBand.astro';
import DemoCTA from '../components/DemoCTA.astro';
import { features } from '../data/features';

// Tight single grid of six. Leagues sits under "Additional modules" instead;
// Team store and the family app are covered in the role section below.
const f = (id: string) => features.find((x) => x.id === id)!;
const grid = [
  f('registration'),
  f('scheduling'),
  f('evaluations'),
  f('coach-toolbox'),
  f('tournaments'),
  f('website'),
];
---

<Base
  title="Features"
  description="Everything a program needs in one platform: registration and payments, scheduling, evaluations, the coach's toolbox, tournaments, leagues, and a view built for every role."
  path="/features/"
>
  <section class="hero pad">
    <div class="wrap center">
      <div class="eyebrow">Everything a program needs</div>
      <h1>One platform. The whole season.</h1>
      <p class="lead">
        Athletic Connect replaces the stack of apps and spreadsheets clubs
        cobble together, so registration, scheduling, evaluations, events, and
        gear all live in one place.
      </p>
      <div class="cbtns">
        <a href="/#demo" class="btn">Request a demo</a>
        <a href="/pricing/" class="btn ghost">See pricing</a>
      </div>
    </div>
  </section>

  <section class="pad grid-sec">
    <div class="wrap">
      <div class="fgrid">
        {grid.map((item) => <FeatureCard feature={item} detailed />)}
      </div>
    </div>
  </section>

  <MoreFeatures />

  <MobileBand
    eyebrow="On the phone"
    heading="Stay on top of the season, wherever you are."
    body="Schedule, RSVPs, invoices, and payments from the phone in your pocket. One login for the whole family, every kid, every team."
    frames={[
      {
        src: '/product/fam-1-schedule.png',
        alt: "A family's schedule on a phone, listing upcoming practices and games with times, teams and locations.",
      },
      {
        src: '/product/fam-2-classes.png',
        alt: 'Booked classes on a phone, each with its time and venue.',
      },
      {
        src: '/product/fam-3-family.png',
        alt: 'The family account on a phone, showing every child on one login.',
      },
    ]}
    flip
  />

  <RoleViews />

  <DemoCTA
    heading="Want to see it on your program?"
    sub="We'll walk you through it on your own club's setup. Leave your email and we'll reach out."
  />
</Base>

<style>
  .hero {
    background:
      radial-gradient(
        1000px 460px at 50% -20%,
        rgba(252, 66, 4, 0.1),
        rgba(252, 66, 4, 0) 60%
      ),
      linear-gradient(180deg, #fff 0%, var(--wash) 100%);
    padding-top: 56px;
  }
  .lead {
    font-size: clamp(16px, 2.1vw, 19px);
    color: var(--ink-2);
    margin: 18px auto 26px;
    max-width: 620px;
  }
  .cbtns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .grid-sec {
    padding-top: 8px;
  }
  .fgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 820px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .fgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
