---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical + og:url, e.g. "/features/" */
  path?: string;
  /** Keep the page out of search results (e.g. the form confirmation page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  path = '/',
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${site.tagline}`;
const canonical = new URL(path, Astro.site ?? site.url).href;
const ogImage = new URL('/brand/og-image.png', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fc4204" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <style is:global>
      /* Scroll reveal. The .rv class is added by script, so with JS disabled
         or broken every section renders normally. */
      .rv {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.2, 0.6, 0.2, 1),
          transform 0.55s cubic-bezier(0.2, 0.6, 0.2, 1);
        will-change: opacity, transform;
      }
      .rv.rv-in {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .rv,
        .rv.rv-in {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal sections as they enter the viewport. The hero is left alone so
      // the first thing a visitor sees is not animating.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const sections = [...document.querySelectorAll('main > section')].slice(1);
        const targets: HTMLElement[] = [];

        for (const section of sections) {
          // stagger the children of a grid, otherwise reveal the block as one
          const grid = section.querySelector<HTMLElement>(
            '.fgrid, .chips, .blocks, .plans, .cards'
          );
          if (grid && grid.children.length > 1) {
            [...grid.children].forEach((child, i) => {
              const el = child as HTMLElement;
              el.style.transitionDelay = `${Math.min(i, 6) * 60}ms`;
              targets.push(el);
            });
            const head = section.querySelector<HTMLElement>(':scope > .wrap > .center, :scope > .wrap > div:first-child');
            if (head && !head.contains(grid)) targets.push(head);
          } else {
            const wrap = section.querySelector<HTMLElement>(':scope > .wrap') ?? (section as HTMLElement);
            targets.push(wrap);
          }
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('rv-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );

        for (const el of targets) {
          el.classList.add('rv');
          io.observe(el);
        }
      }
    </script>
  </body>
</html>
